{
  "manifest_version": 3,
  "name": "Nota — Word & Phrase Notes",
  "version": "0.1.0",
  "description": "Select any word or phrase on a page and save a note or meaning for it. Browse, search, edit and export your saved notes anytime.",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/storage.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Nota"
  }
}
