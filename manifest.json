{
  "manifest_version": 3,
  "name": "Nota — Word & Phrase Notes",
  "version": "0.1.0",
  "description": "Select text to save a note with translation suggestions and Swedish grammar lookup. Search, edit, and export your saved notes.",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://translate.googleapis.com/*", "https://spraakbanken4.it.gu.se/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/storage.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Nota"
  }
}
